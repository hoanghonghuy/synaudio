# Production configuration template — inject secrets from your secret manager.
# Copy to your orchestrator env file; never commit real production values.

APP_ENV=production
HTTP_ADDR=:8080

# PostgreSQL (TLS required in production)
DATABASE_URL=

# Private object storage (HTTPS endpoint; not minio provider in production)
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://example.r2.cloudflarestorage.com
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_AUDIO_URL_TTL=15m

# Real providers — mock modes rejected at startup
AI_MODE=gemini
TTS_MODE=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=

AUDIO_PROCESSOR_MODE=ffmpeg
FFMPEG_BINARY=ffmpeg

APP_PUBLIC_URL=https://app.example.com
API_PUBLIC_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

EMAIL_MODE=smtp
EMAIL_PAYLOAD_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

ACCESS_TOKEN_TTL=15m
ACCESS_TOKEN_MAX_TTL=15m
ACCESS_TOKEN_ACTIVE_KID=
ACCESS_TOKEN_KEYS=

REFRESH_SESSION_TTL=720h
REFRESH_SESSION_IDLE_TTL=168h
RECENT_AUTH_WINDOW=10m

# Required: unique per concurrent worker replica
WORKER_ID=

# Private operator surfaces (loopback/private bind only)
WORKER_PROBE_ADDR=127.0.0.1:8081
WORKER_METRICS_ADDR=127.0.0.1:9091
# API_METRICS_ADDR=127.0.0.1:9090

# When auth abuse controls (#50) are enabled in production:
# AUTH_ABUSE_BACKEND=postgres
