APP_ENV=development
HTTP_ADDR=:8080
SYNAUDIO_API_PORT=18080

DATABASE_URL=postgres://synaudio:synaudio@localhost:5432/synaudio?sslmode=disable

STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=synaudio
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
SIGNED_AUDIO_URL_TTL=15m

# Provider selection. Local development/tests may intentionally use mock.
# Production must select supported real providers; runtime never falls back to mock.
AI_MODE=mock
TTS_MODE=mock

# Required when AI_MODE=gemini or TTS_MODE=gemini.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Gemini provider-native prebuilt voice name (for example Kore), not a Synaudio logical voice_id.
GEMINI_TTS_VOICE=Kore

APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

ALLOW_REMOTE_DATABASE_IN_DEV=false
ALLOW_REMOTE_STORAGE_IN_DEV=false

ACCESS_TOKEN_TTL=15m
REFRESH_SESSION_TTL=720h
RECENT_AUTH_WINDOW=10m
