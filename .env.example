APP_ENV=development
HTTP_ADDR=:8080
SYNAUDIO_API_PORT=18080

DATABASE_URL=postgres://synaudio:synaudio@localhost:5432/synaudio?sslmode=disable

# PostgreSQL pool capacity. Development may omit DATABASE_POOL_MAX_CONNS to use the
# explicit pgx default max(4, NumCPU). Production requires explicit per-process
# limits plus the budget inputs documented in docs/operations/database-pool-capacity.md.
# DATABASE_POOL_MAX_CONNS=10
# DATABASE_POOL_PROCESS_ROLE=api
# DATABASE_CONNECTION_BUDGET=100
# DATABASE_POOL_API_REPLICAS=2
# DATABASE_POOL_WORKER_REPLICAS=1
# DATABASE_POOL_API_MAX_CONNS=10
# DATABASE_POOL_WORKER_MAX_CONNS=5
# DATABASE_POOL_OPERATIONS_RESERVE=5
# DATABASE_POOL_ROLLOUT_SURGE_FACTOR=2

STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=synaudio
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
SIGNED_AUDIO_URL_TTL=15m

# Provider selection. Local development/tests may intentionally use mock.
# Production must select supported real providers; runtime never falls back to mock.
AI_MODE=mock
TTS_MODE=mock

# Audio processing is explicit. Development defaults to mock; production defaults
# to and requires ffmpeg. The configured binary is validated before the API serves.
AUDIO_PROCESSOR_MODE=mock
FFMPEG_BINARY=ffmpeg

# Required when AI_MODE=gemini or TTS_MODE=gemini.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Gemini provider-native prebuilt voice name (for example Kore), not a Synaudio logical voice_id.
GEMINI_TTS_VOICE=Kore

APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Transactional verification/reset email. Development can keep this disabled or
# point SMTP at a local mailbox such as Mailpit. Production requires EMAIL_MODE=smtp.
EMAIL_MODE=disabled
# Dedicated secret used only to encrypt one-time links in the durable email outbox.
# Use a random value >= 32 bytes; never commit the production value.
EMAIL_PAYLOAD_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@synaudio.local
SMTP_TIMEOUT=10s

ALLOW_REMOTE_DATABASE_IN_DEV=false
ALLOW_REMOTE_STORAGE_IN_DEV=false

# Private operator surfaces (loopback/private bind only; see production-deployment.md)
# WORKER_PROBE_ADDR=127.0.0.1:8081
# WORKER_METRICS_ADDR=127.0.0.1:9091
# API_METRICS_ADDR=127.0.0.1:9090

# Authentication/session lifecycle.
ACCESS_TOKEN_TTL=15m
# Maximum lifetime accepted by the verifier. Keep this >= ACCESS_TOKEN_TTL and use
# it when calculating key-rotation overlap/removal timing.
ACCESS_TOKEN_MAX_TTL=15m
# Production requires an explicit bounded kid-based keyring. Format is a comma-
# separated list of kid=secret entries (1-4 keys); every secret must be >=32 bytes.
# The active kid signs new tokens; all configured keys may verify existing tokens.
# Never commit production values. Example placeholders only:
ACCESS_TOKEN_ACTIVE_KID=
ACCESS_TOKEN_KEYS=
# Development-only zero-setup compatibility secret. Production does not depend on
# ACCESS_TOKEN_SECRET; it must configure ACCESS_TOKEN_ACTIVE_KID/ACCESS_TOKEN_KEYS.
ACCESS_TOKEN_SECRET=development-only-access-token-secret-change-me
# Absolute refresh-session lifetime and inactivity timeout.
REFRESH_SESSION_TTL=720h
REFRESH_SESSION_IDLE_TTL=168h
RECENT_AUTH_WINDOW=10m
